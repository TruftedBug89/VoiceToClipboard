{
  "name": "voicetoclipboard",
  "version": "4.0.0",
  "description": "Lightweight, always-on-top Windows widget that transcribes your voice with Gemini AI and copies the text to your clipboard.",
  "main": "main.js",
  "author": "TruftedBug89",
  "license": "MIT",
  "homepage": "https://github.com/TruftedBug89/VoiceToClipboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/TruftedBug89/VoiceToClipboard.git"
  },
  "bugs": {
    "url": "https://github.com/TruftedBug89/VoiceToClipboard/issues"
  },
  "keywords": [
    "speech-to-text",
    "stt",
    "gemini-ai",
    "clipboard",
    "floating-widget",
    "electron",
    "windows",
    "productivity"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-js.js",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir",
    "clean:dist": "node scripts/clean-dist.js",
    "icon": "node scripts/generate-icon.js"
  },
  "build": {
    "appId": "com.voicetoclipboard.app",
    "productName": "VoiceToClipboard",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VoiceToClipboard",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "asarUnpack": [
      "node_modules/sherpa-onnx-win-x64/**/*",
      "node_modules/koffi/**/*",
      "node_modules/vosk-koffi/**/*",
      "node_modules/uiohook-napi/**/*"
    ],
    "files": [
      "main.js",
      "win32.js",
      "index.html",
      "renderer.js",
      "stt/**/*",
      "package.json",
      "build/**/*",
      "locales/**/*"
    ],
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "sherpa-onnx-node": "1.13.4",
    "tar": "^7.5.22",
    "uiohook-napi": "^1.5.5",
    "unbzip2-stream": "^1.4.3",
    "vosk-koffi": "1.1.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
